{
  "name": "@s3/api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@aws-sdk/client-sesv2": "3.1136.0",
    "@aws-sdk/client-sqs": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1137.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/multipart": "9.2.1",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-fastify": "12.0.4",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.7.0",
    "@prisma/client": "6.12.0",
    "aws-jwt-verify": "5.1.0",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "10.0.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.3.1",
    "@types/nodemailer": "7.0.1",
    "prisma": "6.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
