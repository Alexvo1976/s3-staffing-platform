# Local development defaults. Copy this file to .env.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL / Prisma
POSTGRES_DB=s3staffing
POSTGRES_USER=s3app
POSTGRES_PASSWORD=local-only-password
DATABASE_URL=postgresql://s3app:local-only-password@localhost:5432/s3staffing?schema=public

# Local administrator only. Production uses Cognito.
AUTH_MODE=local
LOCAL_ADMIN_EMAIL=admin@s3staffing.local
LOCAL_ADMIN_PASSWORD=ChangeMe-Local-Only-123!
JWT_SECRET=replace-with-at-least-32-random-characters

# Production Cognito values (leave blank locally).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_COGNITO_AUTHORITY=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/admin
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3000

# Object storage. Local values point to MinIO.
STORAGE_DRIVER=s3
AWS_REGION=us-east-1
S3_BUCKET=s3staffing-resumes-local
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MAX_RESUME_BYTES=5242880

# Email. Local values point to Mailpit.
EMAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=careers@s3staffing.local
STAFF_NOTIFICATION_EMAIL=admin@s3staffing.local

# Optional production queue URL.
SQS_NOTIFICATION_QUEUE_URL=
